@page
@model asp_Presentaciones.Pages.Ventanas.ProfesoresModel
@{
    ViewData["Titulo"] = "Profesores";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Profesores</h3>
            </div>
            <div align="left"
                 class="bt_panel_buttons">
                <input type="submit"
                       value="Refrescar"
                       asp-page-handler="BtRefrescar"
                       class="btn btn-secondary"
                       disabled="@(Model.Accion != lib_utilidades.Enumerables.Ventanas.Listas)" />
                <input type="submit"
                       value="Nuevo"
                       asp-page-handler="BtNuevo"
                       class="btn btn-secondary"
                       disabled="@(Model.Accion != lib_utilidades.Enumerables.Ventanas.Listas)" />
                <input type="submit"
                       value="Guardar"
                       asp-page-handler="BtGuardar"
                       class="btn btn-success"
                       disabled="@(Model.Accion == lib_utilidades.Enumerables.Ventanas.Listas)" />
                <input type="submit"
                       value="Cancelar"
                       asp-page-handler="BtCancelar"
                       class="btn btn-warning"
                       disabled="@(Model.Accion == lib_utilidades.Enumerables.Ventanas.Listas)" />
            </div>

            @if (Model.Accion != lib_utilidades.Enumerables.Ventanas.Listas ||
            Model.Accion == lib_utilidades.Enumerables.Ventanas.Borrar)
            {
                <input type="hidden"
                       asp-for="@Model.Actual!.Id" />
            }
            @if (Model.Accion == lib_utilidades.Enumerables.Ventanas.Borrar)
            {
                <input type="hidden"
                       asp-for="@Model.Actual!.Nombres" />
                <input type="hidden"
                       asp-for="@Model.Actual!.Apellidos" />
                <input type="hidden"
                       asp-for="@Model.Actual!.Contacto" />
                <input type="hidden"
                       asp-for="@Model.Actual!.FechaContratacion" />
                <input type="hidden"
                       asp-for="@Model.Actual!.Salario" />
                <input type="hidden"
                       asp-for="@Model.Actual!.DepartamentosId" />
                
            }

            @if (Model.Accion == lib_utilidades.Enumerables.Ventanas.Editar)
            {
                <div class="containers_vn panel panel-default">
                    <h3>Nuevo Educador</h3>

                    <div>
                        <div class="form-group">
                            <label class="col-lg-4 control-label">
                                Nombres
                            </label>
                            <div class="col-lg-6">
                                <input id="nmNombres"
                                       class="cts_forms form-control"
                                       asp-for="@Model.Actual!.Nombres" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-4 control-label">
                                Contacto
                            </label>
                            <div class="col-lg-6">
                                <input id="nmContacto"
                                       class="cts_forms form-control"
                                       asp-for="@Model.Actual!.Contacto" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-4 control-label">
                                Fecha Contratacion
                                </label>
                            <div class="col-lg-6">
                                <input id="nmFContratacion"
                                    class="cts_forms form-control"
                                    asp-for="@Model.Actual!.FechaContratacion"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-4 control-label">
                                Salario
                                </label>
                            <div class="col-lg-6">
                                <input id="nmSalario"
                                    class="cts_forms form-control"
                                    asp-for="@Model.Actual!.Salario"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-4 control-label">
                                Identificador de Departamento
                            </label>
                            <div class="col-lg-6">
                                <input id="nmDepartamentoId"
                                       class="cts_forms form-control"
                                       asp-for="@Model.Actual!.DepartamentosId" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                <input type="hidden"
                       asp-for="@Model.Accion" />
                @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Accion == lib_utilidades.Enumerables.Ventanas.Borrar)
            {
                <div class='popup'>
                    <div class='pp_del_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h4 align="left">
                                Desea borrar la entidad?
                            </h4>
                            <h6 align="left">
                                @Model.Actual!.Nombres
                            </h6>
                            <br />
                            <br />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCancelar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Accion == lib_utilidades.Enumerables.Ventanas.Listas ||
            Model.Accion == lib_utilidades.Enumerables.Ventanas.Borrar)
            {
                <input id="flNombre"
                       class="cts_forms form-control"
                       asp-for="@Model.Filtro!.Nombres"
                       asp-for="@Model.Filtro!.Apellidos"
                       asp-for="@Model.Filtro!.Contacto"
                       placeholder="Nombre" />
                <br />

                <div class="containers_vn panel panel-default">
                    <table class="tb_data table table-striped table-bordered table-hover">
                        <tr>
                            <th>
                                Nombres
                            </th>
                            <th>
                                Apellidos
                            </th>
                            <th>
                                Numero Contacto
                            </th>
                            <th>
                                Fecha Contratacion
                            </th>
                            <th>
                                Salario
                            </th>
                            <th>
                                Idntificador de Departamento
                            </th>
                            <th class="cl_actions">
                                Accion
                            </th>
                        </tr>
                        @if (Model != null && Model.Lista != null)
                        {
                            @foreach (var elemento in Model.Lista)
                            {
                                <tr>
                                    <td>
                                        @elemento.Nombres
                                    </td>
                                    <td>
                                        @elemento.Apellidos
                                    </td>
                                    <td>
                                        @elemento.Contacto
                                    </td>
                                    <td>
                                        @elemento.FechaContratacion
                                    </td>
                                    <td>
                                        @elemento.Salario
                                    </td>
                                    <td>
                                        @elemento.DepartamentosId
                                    </td>
                                    <td>
                                        <input type="submit"
                                               value="Modicar"
                                               asp-page-handler="BtModificar"
                                               class="btn btn-secondary"
                                               asp-route-data="@elemento.Id" />
                                        <input type="submit"
                                               value="Borrar"
                                               asp-page-handler="BtBorrarVal"
                                               class="btn btn-secondary"
                                               asp-route-data="@elemento.Id" />
                                    </td>
                                </tr>
                            }
                        }
                    </table>
                </div>
            }
        </form>
    </div>
</center>
